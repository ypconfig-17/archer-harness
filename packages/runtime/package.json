{
  "name": "@archer/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Archer 生命周期、Camp 依赖装配与可追溯执行",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
