    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@archer/agent": "workspace:*",
    "@archer/contracts": "workspace:*",
    "@archer/kernel": "workspace:*",
    "awilix": "^13.0.5",
    "import-meta-resolve": "^4.2.0",
    "@archer/providers": "workspace:*",
    "@archer/camp": "workspace:*",
    "@archer/handler": "workspace:*"
  }
}
