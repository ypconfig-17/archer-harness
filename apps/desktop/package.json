{
  "name": "@archer/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Archer 桌面应用：独立 React 界面、Electron 窗口与后端生命周期",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p renderer/tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p renderer/tsconfig.json --noEmit",
    "dev": "pnpm --filter @archer/server... build && tsc -p tsconfig.json && node scripts/launch.mjs --dev",
    "start": "node scripts/launch.mjs"
  },
  "devDependencies": {
    "@archer/server": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "@archer/client": "workspace:*",
    "@archer/contracts": "workspace:*",
    "@archer/ui": "workspace:*",
    "@base-ui/react": "^1.9.0",
    "@phosphor-icons/react": "^2.1.10",
    "@streamdown/cjk": "1.0.4",
    "@streamdown/code": "2.0.0",
    "@streamdown/math": "1.0.3",
    "@streamdown/mermaid": "1.0.3",
    "@tanstack/react-query": "^5.104.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "katex": "^0.16.47",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.5.0",
    "streamdown": "2.7.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  }
}
